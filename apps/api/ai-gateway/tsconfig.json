{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // O gateway executa em Deno (ADR-0004 D4.4, "Supabase Edge Function"), cujo
    // resolvedor exige extensão explícita no import. `allowImportingTsExtensions`
    // torna os mesmos arquivos válidos para `tsc --noEmit` e para o runtime.
    "allowImportingTsExtensions": true,
    // `fetch`, `Request`, `Response` e `Headers` são APIs web, ausentes de lib ES2022.
    // Nenhuma dependência nova é introduzida por isto (Playbook §15.1).
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src", "tests"]
}
