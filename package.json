{
  "name": "legal-health",
  "version": "0.0.0",
  "private": true,
  "description": "Legal Health 2.0 — monorepo oficial (ADR-0001). Hierarquia normativa em docs/.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p apps/api/ai-gateway/tsconfig.json",
    "build:web": "npm run build --workspace web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
